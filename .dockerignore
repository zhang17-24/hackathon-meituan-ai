# ============================================================
# NailFlow .dockerignore
# ============================================================
# 防止密钥和本地配置被打入 Docker 镜像

# 环境变量（含密钥）
.env
.env.*
backend/.env
backend/.env.*

# 开发/运行时本地状态
**/.deer-flow/
**/.nail-flow/
**/.mp-venv/
# backend/data 只排除运行时内容，保留系统资产（styles/knowledge/seed_images/hand_landmarker.task）
backend/data/*
!backend/data/styles/
!backend/data/styles/**
!backend/data/knowledge/
!backend/data/knowledge/**
!backend/data/seed_images/
!backend/data/seed_images/**
!backend/data/mock/
!backend/data/mock/**
!backend/data/hand_landmarker.task
backend/*.db
backend/*.db-shm
backend/*.db-wal

# 依赖
**/node_modules/
**/.venv/
**/__pycache__/
**/.mypy_cache/
**/.ruff_cache/

# 构建产物
**/.next/
**/dist/
**/*.tsbuildinfo

# Git
.git/
.gitignore
.gitattributes

# CI / IDE
.github/
.vscode/
.idea/
*.swp
*.swo

# 文档和测试（不需要进镜像）
docs/
**/tests/
**/test-results/
**/playwright-report/

# 大文件 / 无关文件
*.zip
*.sst
research/
美甲图片/
美甲图片.zip
微信图片_*.jpg
*.xlsx

# macOS
.DS_Store
