# ============================================================
# nailflow 环境变量模板 — 复制为 .env 并填入真实值
#   cp .env.example .env && vim .env
# .env 被 .gitignore 忽略，不会进入 git / Docker 镜像
# ============================================================

# ── JWT 签名密钥（必填，建议随机生成）────────────
#   openssl rand -hex 32
AUTH_JWT_SECRET=

# ── LLM 模型 API ─────────────────────────────────
# config.yaml 的 models 引用这些变量（取消注释你用的模型对应项）
MINIMAX_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# ── 美甲生图 API（未配置时自动进入 mock 模式）───
NAIL_IMAGE_API_KEY=
NAIL_IMAGE_API_URL=
NAIL_IMAGE_MODEL=doubao-seedream-5-0-260128

# ── 可选：飞书 / 小红书（不启用留空）────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OPS_WEBHOOK_URL=
XIAOHONGSHU_COOKIE=

# ── 可选：CORS（前端与后端不同源时填写）──────────
# GATEWAY_CORS_ORIGINS=https://your-frontend.example.com

# ── 可选：数据路径（默认即可）────────────────────
# NAIL_DB_PATH=./data/nailflow.db
# NAIL_UPLOADS_DIR=./data/uploads
# NAIL_RESULTS_DIR=./data/results
